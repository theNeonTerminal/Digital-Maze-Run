  0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F,
  0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F,
  0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F,
  0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x201F, 0x0000
};

const int maze_main_width  = 320;
const int maze_main_height = 240;

#define MPU_ADDR        0x68
#define BALL_R          3 // ball radious (in px)
#define BALL_COLOR      ILI9341_RED
#define SPEED           2
#define TILT_THRESHOLD  2.0

#define SWAP_XY         0
#define INVERT_X        0
#define INVERT_Y        0

// Maze start (gap in top wall) and goal (gap in bottom wall), from the image
#define START_X         152
#define START_Y         8
#define GOAL_X0         160
#define GOAL_X1         173
#define GOAL_Y          235

Adafruit_MPU6050 mpu;
int ballX, ballY;

void readTilt(float &x, float &y) { // get current tilt from mpu in m/s^2
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);
  x = a.acceleration.x;
  y = a.acceleration.y;
}

bool isWall(int x, int y) { // detect walls
  if (x < 0 || x >= maze_main_width || y < 0) return true;  // screen edges
  if (y >= maze_main_height) return false;                   // below screen = exit
  uint16_t c = pgm_read_word(&maze_main[y * maze_main_width + x]);
  uint8_t blue  = c & 0x1F;
  uint8_t green = (c >> 5) & 0x3F;
  return (blue >= 12 && green < 32);
}

bool hitsWall(int cx, int cy) {
  for (int dy = -BALL_R; dy <= BALL_R; dy++)
    for (int dx = -BALL_R; dx <= BALL_R; dx++)
      if (dx * dx + dy * dy <= BALL_R * BALL_R && isWall(cx + dx, cy + dy))
        return true;
  return false;
}

void eraseBall(int cx, int cy) {
  static uint16_t buf[(2 * BALL_R + 1) * (2 * BALL_R + 1)];
  int x0 = max(cx - BALL_R, 0), x1 = min(cx + BALL_R, maze_main_width - 1);
  int y0 = max(cy - BALL_R, 0), y1 = min(cy + BALL_R, maze_main_height - 1);
  int w = x1 - x0 + 1, h = y1 - y0 + 1;
  for (int y = 0; y < h; y++)
    for (int x = 0; x < w; x++)
      buf[y * w + x] = pgm_read_word(&maze_main[(y0 + y) * maze_main_width + x0 + x]);
  tft.drawRGBBitmap(x0, y0, buf, w, h);
}

void startLevel() {
  tft.drawRGBBitmap(0, 0, maze_main, maze_main_width, maze_main_height);
  ballX = START_X;
  ballY = START_Y;
  tft.fillCircle(ballX, ballY, BALL_R, BALL_COLOR);
}

void showYouWin() {
  tft.fillRect(104, 106, 112, 28, ILI9341_BLACK);
  tft.drawRect(104, 106, 112, 28, ILI9341_GREEN);
  tft.setTextSize(2);
  tft.setTextColor(ILI9341_GREEN);
  tft.setCursor(112, 113);
  tft.print("YOU WIN!");
  delay(3000);
}

void setup() {
  Serial.begin(115200);

  Wire.begin(I2C_SDA, I2C_SCL);
  if (!mpu.begin(MPU_ADDR, &Wire)) {
    Serial.println("MPU6050 not found");
    while (1) delay(10);
  }
  mpu.setAccelerometerRange(MPU6050_RANGE_2_G);
  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);

  tft.begin();
  tft.setRotation(1);  // Landscape
  startLevel();
}

void loop() {
  float tx, ty;
  readTilt(tx, ty);
  if (SWAP_XY)  { float t = tx; tx = ty; ty = t; }
  if (INVERT_X) tx = -tx;
  if (INVERT_Y) ty = -ty;

  int dx = 0, dy = 0; // constant speed, could not add acceleration/friction
  if (tx >  TILT_THRESHOLD) dx =  SPEED;
  if (tx < -TILT_THRESHOLD) dx = -SPEED;
  if (ty >  TILT_THRESHOLD) dy =  SPEED;
  if (ty < -TILT_THRESHOLD) dy = -SPEED;

  int newX = ballX, newY = ballY;
  if (dx != 0 && !hitsWall(ballX + dx, ballY)) newX = ballX + dx;
  if (dy != 0 && !hitsWall(newX, ballY + dy))  newY = ballY + dy;

  if (newX != ballX || newY != ballY) {
    eraseBall(ballX, ballY);
    ballX = newX;
    ballY = newY;
    tft.fillCircle(ballX, ballY, BALL_R, BALL_COLOR);
  }

  if (ballY >= GOAL_Y && ballX >= GOAL_X0 && ballX <= GOAL_X1) {
    showYouWin();
    startLevel();
  }

  delay(10);
}
